<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RemotePCPlus" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>

    <style name="Theme.RemotePCPlus.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>
</resources>
