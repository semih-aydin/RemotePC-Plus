<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/ink_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/appearance"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/btnThemeLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:minHeight="0dp"
            android:text="@string/theme_light"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnThemeDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_idle"
            android:minHeight="0dp"
            android:text="@string/theme_dark"
            android:textAllCaps="false"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnThemeSystem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_idle"
            android:minHeight="0dp"
            android:text="@string/theme_system"
            android:textAllCaps="false"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sensitivity"
            android:textColor="@color/ink_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSensValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="1.4x"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekSens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <CheckBox
        android:id="@+id/chkNaturalScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/natural_scroll"
        android:textColor="@color/ink_primary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/chkDoubleTapDrag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/double_tap_drag"
        android:textColor="@color/ink_primary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/chkHaptics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/haptics"
        android:textColor="@color/ink_primary"
        android:textSize="14sp" />
</LinearLayout>
