<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/keyboard"
            android:textColor="@color/ink_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKbVoice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_accent"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/voice_type"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etKeyboardInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_dark"
        android:hint="@string/type_hint"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_tertiary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbSend"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_accent"
            android:text="@string/send"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKbEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Enter"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnKbBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/backspace"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbEsc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Esc"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Tab"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbSpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/space"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/key_left"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/key_up"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/key_down"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="@string/key_right"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
