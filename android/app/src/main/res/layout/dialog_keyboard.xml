<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Klavye"
        android:textColor="@color/ink_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etKeyboardInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_dark"
        android:hint="Metin yazın..."
        android:imeOptions="actionSend"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_tertiary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbSend"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_accent"
            android:text="Gönder"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKbEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Enter"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnKbBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Sil"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Özel Tuşlar & Ok Tuşları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbEsc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Esc"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Tab"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbSpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/bg_btn_dark"
            android:text="Boşluk"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKbLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Sol"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Yukarı"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Aşağı"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKbRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dark"
            android:text="Sağ"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
