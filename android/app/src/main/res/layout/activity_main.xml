<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ÜST BAR: PC Durumu + Vektör Araçlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pcStatusPill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_red" />

            <TextView
                android:id="@+id/tvPcName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PC Seç"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="Bağlı değil"
                android:textColor="@color/signal_red"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnKeyboard"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card"
            android:contentDescription="Klavye"
            android:scaleType="center"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/ink_primary" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card"
            android:contentDescription="Ayarlar"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/ink_primary" />
    </LinearLayout>

    <!-- APPLE SEGMENTED CONTROL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/tabTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:minHeight="0dp"
            android:text="Touchpad"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_idle"
            android:minHeight="0dp"
            android:text="Kumanda &amp; Araçlar"
            android:textAllCaps="false"
            android:textColor="@color/ink_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ÇOKLU MONİTÖR ÇUBUĞU -->
    <LinearLayout
        android:id="@+id/monitorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/monitorChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 1. TOUCHPAD GÖRÜNÜMÜ -->
    <LinearLayout
        android:id="@+id/viewTouchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.semih.remotepcplus.TouchpadView
                android:id="@+id/touchpadView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Dikey Kaydırma Rayı -->
            <LinearLayout
                android:id="@+id/scrollStrip"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="44dp"
                    android:background="@color/border_hairline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Alt Tıklama Çubuğu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.35"
                android:background="@drawable/bg_card"
                android:text="Sol Tık"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDragLock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="0.95"
                android:background="@drawable/bg_card"
                android:text="Sürükle"
                android:textAllCaps="false"
                android:textColor="@color/ink_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_card"
                android:text="Sağ Tık"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. KUMANDA & ARAÇLAR GÖRÜNÜMÜ -->
    <ScrollView
        android:id="@+id/viewMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <!-- Aktif Pencere -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif Pencere"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="Masaüstü"
                    android:textColor="@color/ink_primary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Medya Kontrolleri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medya"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMediaPrev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Önceki"
                        android:scaleType="center"
                        android:src="@drawable/ic_prev"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnMediaPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.35"
                        android:background="@drawable/bg_btn_accent"
                        android:contentDescription="Oynat Duraklat"
                        android:scaleType="center"
                        android:src="@drawable/ic_play_pause"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnMediaNext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Sonraki"
                        android:scaleType="center"
                        android:src="@drawable/ic_next"
                        android:tint="@color/ink_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVolDown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Ses Azalt"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_down"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnVolMute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Sessiz"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_mute"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnVolUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Ses Artır"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_up"
                        android:tint="@color/ink_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pano Paylaşımı (Clipboard Sync) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pano Paylaşımı"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnClipSend"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_accent"
                        android:text="PC'ye Yapıştır"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClipGet"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="PC'den Kopyala"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sunum Kontrolleri -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunum"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresPrev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Önceki"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPresNext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:background="@drawable/bg_btn_accent"
                        android:text="Sonraki Slayt"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresStart"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="F5 Başlat"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresStop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Esc Bitir"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresBlack"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Siyah Ekran"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hızlı Başlatıcı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hızlı Başlatıcı"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLaunchBrowser"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Tarayıcı"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchYoutube"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="YouTube"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchSpotify"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Spotify"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLaunchExplorer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Dosyalar"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchTaskMgr"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Görevler"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Ayarlar"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hızlı Kısayollar & Güç -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kısayollar &amp; Sistem"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMacroCopy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Kopyala"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroPaste"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Yapıştır"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroUndo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Geri Al"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMacroDesktop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Masaüstü"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroTaskView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Pencereler"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroClose"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Kapat"
                        android:textAllCaps="false"
                        android:textColor="@color/signal_red"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPowerLock"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Kilitle"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPowerDisplayOff"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Ekranı Kapat"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPowerSleep"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Uyku"
                        android:textAllCaps="false"
                        android:textColor="@color/signal_red"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
