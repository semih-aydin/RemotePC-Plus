<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pcStatusPill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_red" />

            <TextView
                android:id="@+id/tvPcName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/select_pc"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="@string/disconnected"
                android:textColor="@color/signal_red"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnKeyboard"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/keyboard"
            android:scaleType="center"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/ink_primary" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/settings"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/ink_primary" />
    </LinearLayout>

    <!-- Apple Segmented Control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/tabTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:minHeight="0dp"
            android:text="@string/tab_touchpad"
            android:textAllCaps="false"
            android:textColor="@color/ink_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_idle"
            android:minHeight="0dp"
            android:text="@string/tab_remote"
            android:textAllCaps="false"
            android:textColor="@color/ink_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Multi-Monitor Bar -->
    <LinearLayout
        android:id="@+id/monitorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/monitorChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 1. TOUCHPAD VIEW -->
    <LinearLayout
        android:id="@+id/viewTouchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.semih.remotepcplus.TouchpadView
                android:id="@+id/touchpadView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/scrollStrip"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="44dp"
                    android:background="@color/border_hairline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Click Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.35"
                android:background="@drawable/bg_card"
                android:text="@string/left_click"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDragLock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="0.95"
                android:background="@drawable/bg_card"
                android:text="@string/drag"
                android:textAllCaps="false"
                android:textColor="@color/ink_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_card"
                android:text="@string/right_click"
                android:textAllCaps="false"
                android:textColor="@color/ink_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. REMOTE & TOOLS VIEW -->
    <ScrollView
        android:id="@+id/viewMedia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <!-- Active Window & System Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/active_window"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="@string/desktop"
                    android:textColor="@color/ink_primary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvSystemStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="CPU —  •  RAM —"
                    android:textColor="@color/ink_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Media -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMediaPrev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="@string/prev_slide"
                        android:scaleType="center"
                        android:src="@drawable/ic_prev"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnMediaPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.35"
                        android:background="@drawable/bg_btn_accent"
                        android:contentDescription="@string/media"
                        android:scaleType="center"
                        android:src="@drawable/ic_play_pause"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnMediaNext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="@string/next_slide"
                        android:scaleType="center"
                        android:src="@drawable/ic_next"
                        android:tint="@color/ink_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVolDown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Vol -"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_down"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnVolMute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Mute"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_mute"
                        android:tint="@color/ink_primary" />

                    <ImageButton
                        android:id="@+id/btnVolUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:contentDescription="Vol +"
                        android:scaleType="center"
                        android:src="@drawable/ic_vol_up"
                        android:tint="@color/ink_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Clipboard Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clipboard_sync"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnClipSend"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_accent"
                        android:text="@string/paste_to_pc"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClipGet"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/copy_from_pc"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Presentation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/presentation"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresPrev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/prev_slide"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPresNext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:background="@drawable/bg_btn_accent"
                        android:text="@string/next_slide"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresStart"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/pres_start"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresStop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/pres_stop"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresBlack"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/pres_black"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Launcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_launcher"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLaunchBrowser"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_browser"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchYoutube"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_youtube"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchSpotify"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_spotify"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLaunchExplorer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_files"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchTaskMgr"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_taskmgr"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnLaunchSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/app_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Window & Desktop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/window_desktop"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSnapLeft"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/snap_left"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSnapMax"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/snap_max"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="11.5sp" />

                    <Button
                        android:id="@+id/btnSnapRight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/snap_right"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSnapMin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/snap_min"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDeskPrev"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/prev_desktop"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDeskNext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/next_desktop"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shortcuts & System -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_system"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMacroCopy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/copy"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroPaste"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/paste"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroUndo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/undo"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMacroDesktop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/desktop"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroTaskView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/windows_view"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMacroClose"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/close"
                        android:textAllCaps="false"
                        android:textColor="@color/signal_red"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPowerLock"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/lock"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPowerDisplayOff"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/display_off"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPowerSleep"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:text="@string/sleep"
                        android:textAllCaps="false"
                        android:textColor="@color/signal_red"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
